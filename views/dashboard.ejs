<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>eBay Reseller — Dashboard</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; color: #222; }
    h1 { display: flex; justify-content: space-between; align-items: baseline; font-size: 1.4rem; }
    h1 a { font-size: 0.9rem; font-weight: normal; }
    section { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; }
    label { display: block; font-weight: 600; margin-bottom: 0.25rem; margin-top: 1rem; }
    input, textarea { width: 100%; box-sizing: border-box; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; }
    button { margin-top: 1rem; background: #0064d2; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 4px; font-weight: 600; cursor: pointer; }
    button.run { background: #2e7d32; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td { text-align: left; padding: 0.4rem; border-bottom: 1px solid #eee; }
    .status-running { color: #b58900; }
    .status-success { color: #2e7d32; }
    .status-failed { color: #c62828; }
  </style>
</head>
<body>
  <h1>eBay Reseller <a href="/logout">Log out</a></h1>
  <p>Connected as <strong><%= client.ebay_username %></strong> (<%= process.env.EBAY_ENV === 'production' ? 'production' : 'sandbox' %>)</p>

  <section>
    <h2>Settings</h2>
    <form method="post" action="/dashboard/settings">
      <label for="item_limit">Item limit per run</label>
      <input type="number" id="item_limit" name="item_limit" min="1" value="<%= client.item_limit %>">

      <label for="keywords">Brand keywords (comma-separated, leave blank for all items)</label>
      <textarea id="keywords" name="keywords" rows="2"><%= client.keywords.join(', ') %></textarea>

      <label for="days_left_threshold">End listings with fewer than this many days left</label>
      <input type="number" id="days_left_threshold" name="days_left_threshold" min="1" value="<%= client.days_left_threshold %>">

      <label for="max_views">End listings with this many views or fewer</label>
      <input type="number" id="max_views" name="max_views" min="0" value="<%= client.max_views %>">

      <button type="submit">Save settings</button>
    </form>
  </section>

  <section>
    <h2>Run</h2>
    <form method="post" action="/dashboard/run">
      <button class="run" type="submit">Run now</button>
    </form>
  </section>

  <section>
    <h2>Run history</h2>
    <table>
      <tr><th>Started</th><th>Status</th><th>Log</th></tr>
      <% runs.forEach(run => { %>
        <tr>
          <td><%= run.started_at.toLocaleString() %></td>
          <td class="status-<%= run.status %>"><%= run.status %></td>
          <td><pre style="white-space: pre-wrap; margin: 0; font-size: 0.85rem;"><%= run.log %></pre></td>
        </tr>
      <% }) %>
      <% if (runs.length === 0) { %>
        <tr><td colspan="3">No runs yet.</td></tr>
      <% } %>
    </table>
  </section>
</body>
</html>
